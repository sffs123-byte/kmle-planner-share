rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'sffs123@gmail.com';
    }

    match /cpxBoards/{boardId} {
      allow read, write: if isOwner();
      match /scripts/{scriptId} {
        allow read, write: if isOwner();
      }
    }
  }
}
